# Generated by packaging/homebrew/formula.sh for mbus-kit @VERSION@; do not edit.
class Mbus < Formula
  desc "Decode, read, search and listen to M-Bus and wireless M-Bus meters"
  homepage "https://hupe1980.github.io/mbus-kit/"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/hupe1980/mbus-kit/releases/download/v@VERSION@/mbus-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_aarch64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/hupe1980/mbus-kit/releases/download/v@VERSION@/mbus-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_aarch64-unknown-linux-musl@"
    end
    on_intel do
      url "https://github.com/hupe1980/mbus-kit/releases/download/v@VERSION@/mbus-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_x86_64-unknown-linux-musl@"
    end
  end

  def install
    bin.install "mbus"
  end

  def caveats
    <<~EOS
      mbus configures serial devices with stty; your user needs access to them
      (Linux: the dialout group). Try it without hardware:
        echo "68 1F 1F 68 08 02 72 78 56 34 12 24 40 01 07 55 00 00 00 03 13 15 31 00 DA 02 3B 13 01 8B 60 04 37 18 02 18 16" | mbus decode
    EOS
  end

  test do
    # OMS Annex N N.2.3: mode 7, CMAC verified with the published example key.
    input = <<~EOS
      key 000102030405060708090A0B0C0D0E0F
      434493157856341233037AC98C2075900F002C25B30A000021924D4FBA372FB66E017A75002007109058475F4BC9D1281DF878B80A1B0F98B629024AAC7279429398BFC549233C0140829B93BAA1
    EOS
    output = pipe_output("#{bin}/mbus decode", input)
    assert_match "authenticated (counter 2739)", output
    assert_match "volume — 28504.27 m³", output
    assert_match "mbus #{version}", shell_output("#{bin}/mbus --version")
  end
end
